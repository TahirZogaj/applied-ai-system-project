%% Architecture of the AI Music Recommender (RAG over the song catalog).
flowchart TD
    U([User request in plain English]) --> G1{Guardrail:<br/>validate request}
    G1 -- empty / too long --> ERR[Show error message]
    G1 -- ok --> P[Parse request into taste profile<br/>Gemini, JSON output]
    P -- LLM error --> KP[Keyword parser fallback]
    P --> G2{Guardrail:<br/>clean profile}
    KP --> G2
    G2 -->|clamp energy, fix types,<br/>flag unknown genre/mood| R

    subgraph Retrieval["Retrieval (Module 3 scorer)"]
        CSV[(data/songs.csv)] --> R[score_song + recommend_songs<br/>top 8 candidates]
    end

    R --> W{Weak match?<br/>top score < 2.0}
    W -->|add warning| GEN
    W --> GEN[Generate answer<br/>Gemini sees ONLY the 8 candidates]
    GEN --> G3{Guardrail:<br/>picks must be retrieved ids}
    G3 -- invented ids dropped --> OUT
    G3 -- no valid picks / LLM error --> TPL[Template answer<br/>scorer reasons]
    TPL --> OUT([Ranked picks + explanations + warnings])

    LOG[(logs/assistant.log)]
    P -.logs.-> LOG
    R -.logs.-> LOG
    G3 -.logs.-> LOG

    subgraph Testing
        T[[pytest: guardrails, grounding,<br/>fallbacks with fake LLM]]
        E[[src/evaluate.py: hit@1, precision@5,<br/>grounding, consistency vs. offline baseline]]
    end
    E -.runs.-> U
